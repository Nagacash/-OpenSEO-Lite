# OpenSEO-Lite Agent — local / MCP environment
# Copy to .env and fill in values you need.

# OpenRouter (supports free models ending in :free)
OPENROUTER_API_KEY=
LLM_PROVIDER=openrouter
LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free

# NVIDIA NIM (optional)
# NVIDIA_API_KEY=
# LLM_PROVIDER=nvidia
# LLM_MODEL=meta/llama-3.1-70b-instruct

# Generic OpenAI-compatible / Anthropic (optional)
# LLM_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Gemini — used by the web playground server when set
# GEMINI_API_KEY=

# MCP SSE / Express host
PORT=8000
HOST=127.0.0.1

# Optional public URL for the web UI
# APP_URL=http://localhost:3000
